{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django (BS5 - port 9061)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "runserver",
                "0.0.0.0:9061"
            ],
            "django": true,
            "autoStartBrowser": false,
            "justMyCode": false
        },
        {
            "name": "Django (BS3 before - port 9062)",
            "type": "debugpy",
            "request": "launch",
            "program": "/data/data/projects/apiary-before/manage.py",
            "python": "${workspaceFolder}/venv/bin/python",
            "cwd": "/data/data/projects/apiary-before",
            "args": [
                "runserver",
                "0.0.0.0:9062"
            ],
            "env": {
                "SESSION_COOKIE_NAME": "sessionid_before"
            },
            "django": true,
            "autoStartBrowser": false,
            "justMyCode": false
        },
        {
            "name": "Vite Dev Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/disturbance/frontend/disturbance"
        }
    ],
    "compounds": [
        {
            "name": "Django BS5 + BS3 (9061 + 9062)",
            "configurations": [
                "Django (BS5 - port 9061)",
                "Django (BS3 before - port 9062)"
            ],
            "stopAll": true
        },
        {
            "name": "Django BS5 + Vite (9061 + 5173)",
            "configurations": [
                "Django (BS5 - port 9061)",
                "Vite Dev Server"
            ],
            "stopAll": true
        }
    ]
}